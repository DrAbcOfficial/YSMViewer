<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>24</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationId>net.drabc.ysmviewer</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <RuntimeIdentifier>android-arm64</RuntimeIdentifier>
    <BrowserPublishRoot>browser-publish</BrowserPublishRoot>
    <MonoAndroidAssetsPrefix>Assets;$(BrowserPublishRoot)</MonoAndroidAssetsPrefix>
  </PropertyGroup>

  <ItemGroup>
    <AndroidResource Include="..\YSMViewer\Assets\Icon.png" Link="Resources\drawable\icon.png" />
  </ItemGroup>

  <Target Name="PublishBrowserForAndroid" BeforeTargets="AssignTargetPaths">
    <RemoveDir Directories="$(BrowserPublishRoot)" />
    <Exec Command="dotnet publish &quot;..\YSMViewer.Browser\YSMViewer.Browser.csproj&quot; -c $(Configuration) -o &quot;$(MSBuildProjectDirectory)\$(BrowserPublishRoot)&quot;" />
    <ItemGroup>
      <RedundantBrowserAsset Include="$(BrowserPublishRoot)\wwwroot\**\*.br;$(BrowserPublishRoot)\wwwroot\**\*.gz" />
      <AndroidAsset Remove="@(RedundantBrowserAsset)" />
    </ItemGroup>
    <Delete Files="@(RedundantBrowserAsset)" />
    <ItemGroup>
      <AndroidAsset Include="$(BrowserPublishRoot)\wwwroot\**\*" Exclude="$(BrowserPublishRoot)\wwwroot\**\*.br;$(BrowserPublishRoot)\wwwroot\**\*.gz" />
    </ItemGroup>
  </Target>
</Project>
