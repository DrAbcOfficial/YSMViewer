<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:YSMViewer.ViewModels"
             xmlns:a="https://sunce.tech/aura3d"
             xmlns:v="clr-namespace:YSMViewer.Views"
             mc:Ignorable="d" d:DesignWidth="1024" d:DesignHeight="680"
             x:Class="YSMViewer.Views.MainView"
             x:DataType="vm:MainViewModel">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="*,Auto" Background="{DynamicResource ThemeBgViewport}">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto,320" Background="{DynamicResource ThemeBgViewport}">
            <!-- Viewport -->
            <Border Grid.Column="0" Background="{DynamicResource ThemeBgViewport}" MinWidth="200">
                <Panel x:Name="ViewportPanel">
                    <a:Aura3DView
                        x:Name="AuraView"
                        SceneInitialized="OnSceneInitialized"
                        SceneUpdated="OnSceneUpdated" />
                    <Border x:Name="GizmoBorder"
                            Width="120" Height="120"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Margin="0,0,12,12"
                            Background="Transparent"
                            CornerRadius="6"
                            PointerEntered="OnGizmoPointerEntered"
                            PointerExited="OnGizmoPointerExited"
                            PointerPressed="OnGizmoPointerPressed"
                            PointerReleased="OnGizmoPointerReleased">
                        <a:Aura3DView
                            x:Name="GizmoView"
                            IsHitTestVisible="False"
                            SceneInitialized="OnGizmoSceneInitialized" />
                    </Border>
                    <Border x:Name="RadialOverlay"
                            IsVisible="False"
                            Background="#80000000"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            CornerRadius="100"
                            Padding="0">
                        <v:RadialMenu x:Name="RadialMenuControl"
                                      Width="200" Height="200" />
                    </Border>
                </Panel>
            </Border>

            <!-- Splitter -->
            <GridSplitter Grid.Column="1" Width="4"
                          Background="{DynamicResource ThemeBorder}"
                          ResizeDirection="Columns" />

            <!-- Side Panel -->
            <Border Grid.Column="2" Background="{DynamicResource ThemeBgPanel}" MinWidth="240"
                    IsVisible="{Binding HasModel}">
                <TabControl Background="Transparent" BorderThickness="0"
                            Padding="0">
                    <TabControl.Styles>
                        <Style Selector="TabItem">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Foreground" Value="{DynamicResource ThemeTextSecondary}" />
                            <Setter Property="FontSize" Value="12" />
                            <Setter Property="Padding" Value="14,8" />
                            <Setter Property="BorderThickness" Value="0" />
                        </Style>
                        <Style Selector="TabItem:selected">
                            <Setter Property="Foreground" Value="{DynamicResource ThemeAccent}" />
                            <Setter Property="Background" Value="{DynamicResource ThemeTabActiveBg}" />
                        </Style>
                        <Style Selector="TabItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                            <Setter Property="Background" Value="{DynamicResource ThemeTabHoverBg}" />
                        </Style>
                        <Style Selector="TabItem:selected /template/ ContentPresenter#PART_ContentPresenter">
                            <Setter Property="Background" Value="{DynamicResource ThemeTabActiveBg}" />
                        </Style>
                        <Style Selector="TabItem:selected">
                            <Setter Property="BorderBrush" Value="{DynamicResource ThemeAccent}" />
                            <Setter Property="BorderThickness" Value="0,0,0,2" />
                        </Style>
                    </TabControl.Styles>

                    <!-- Tab 1: Info -->
                    <TabItem Header="Info">
                        <ScrollViewer>
                            <StackPanel Spacing="14" Margin="12">
                                <TextBlock Text="{Binding ModelDisplayName}"
                                           FontSize="18" Foreground="{DynamicResource ThemeTextPrimary}"
                                           FontWeight="Bold" TextWrapping="Wrap" />

                                <Border Height="1" Background="{DynamicResource ThemeDivider}" />

                                <StackPanel Spacing="8">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="Version" FontSize="11"
                                                   Foreground="{DynamicResource ThemeTextMuted}" Width="60" />
                                        <TextBlock Text="{Binding ModelVersion}"
                                                   FontSize="12" Foreground="{DynamicResource ThemeTextSecondary}" />
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Spacing="8"
                                                IsVisible="{Binding !!ModelAuthors}">
                                        <TextBlock Text="Authors" FontSize="11"
                                                   Foreground="{DynamicResource ThemeTextMuted}" Width="60" />
                                        <TextBlock Text="{Binding ModelAuthors}"
                                                   FontSize="12" Foreground="{DynamicResource ThemeTextSecondary}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Spacing="8"
                                                IsVisible="{Binding !!ModelLicense}">
                                        <TextBlock Text="License" FontSize="11"
                                                   Foreground="{DynamicResource ThemeTextMuted}" Width="60" />
                                        <TextBlock Text="{Binding ModelLicense}"
                                                   FontSize="12" Foreground="{DynamicResource ThemeTextSecondary}" />
                                        <Border Background="{DynamicResource ThemeAccentGreen}" CornerRadius="3"
                                                Padding="5,1"
                                                IsVisible="{Binding IsFreeModel}">
                                            <TextBlock Text="FREE" FontSize="9"
                                                       Foreground="{DynamicResource ThemeBgViewport}"
                                                       FontWeight="Bold" />
                                        </Border>
                                    </StackPanel>
                                </StackPanel>

                                <TextBlock Text="{Binding ModelTips}"
                                           FontSize="11" Foreground="{DynamicResource ThemeTextLabel}"
                                           TextWrapping="Wrap"
                                           IsVisible="{Binding !!ModelTips}" />
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- Tab 2: Bones -->
                    <TabItem Header="Bones">
                        <Grid RowDefinitions="Auto,*" Margin="12,8,12,0">
                            <Grid.Resources>
                                <SolidColorBrush x:Key="TreeViewItemForeground"
                                                 Color="{DynamicResource ThemeTreeArrow}" />
                            </Grid.Resources>
                            <StackPanel Grid.Row="0"
                                        Orientation="Horizontal" Spacing="6"
                                        Margin="0,0,0,8">
                                <Button Content="Expand All" FontSize="10"
                                        Background="{DynamicResource ThemeBgButton}"
                                        Foreground="{DynamicResource ThemeTextSecondary}"
                                        Padding="8,3" CornerRadius="3"
                                        Click="OnExpandAllBonesClick" />
                                <Button Content="Collapse All" FontSize="10"
                                        Background="{DynamicResource ThemeBgButton}"
                                        Foreground="{DynamicResource ThemeTextSecondary}"
                                        Padding="8,3" CornerRadius="3"
                                        Click="OnCollapseAllBonesClick" />
                            </StackPanel>
                            <ScrollViewer Grid.Row="1">
                                <TreeView ItemsSource="{Binding BoneTreeRoots}"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          Foreground="{DynamicResource ThemeTextPrimary}" FontSize="12">
                                    <TreeView.Styles>
                                        <Style Selector="TreeViewItem">
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="Margin" Value="0" />
                                        </Style>
                                    </TreeView.Styles>
                                    <TreeView.ItemTemplate>
                                        <TreeDataTemplate ItemsSource="{Binding Children}"
                                                          x:DataType="vm:BoneTreeItemViewModel">
                                            <Border Background="{DynamicResource ThemeBgItemRow}"
                                                    CornerRadius="4" Padding="6,3"
                                                    Margin="0,1">
                                                <Grid ColumnDefinitions="Auto,*,Auto">
                                                    <TextBlock Grid.Column="0"
                                                               Text="{Binding Icon}"
                                                               FontSize="13"
                                                               VerticalAlignment="Center"
                                                               Margin="0,0,6,0" />
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding Name}"
                                                               Foreground="{DynamicResource ThemeTextPrimary}"
                                                               FontSize="12"
                                                               VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <ToggleButton Grid.Column="2"
                                                                  Width="28" Height="28"
                                                                  IsChecked="{Binding IsVisible, Mode=TwoWay}"
                                                                  CornerRadius="4" Padding="0"
                                                                  Margin="6,0,0,0"
                                                                  HorizontalContentAlignment="Center"
                                                                  VerticalContentAlignment="Center">
                                                        <ToggleButton.Styles>
                                                            <Style Selector="ToggleButton">
                                                                <Setter Property="Background"
                                                                        Value="{DynamicResource ThemeToggleDefault}" />
                                                            </Style>
                                                            <Style Selector="ToggleButton:checked">
                                                                <Setter Property="Background"
                                                                        Value="{DynamicResource ThemeToggleChecked}" />
                                                            </Style>
                                                            <Style Selector="ToggleButton:unchecked">
                                                                <Setter Property="Background"
                                                                        Value="{DynamicResource ThemeToggleUnchecked}" />
                                                            </Style>
                                                        </ToggleButton.Styles>
                                                        <TextBlock Text="👁" FontSize="13"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center" />
                                                    </ToggleButton>
                                                </Grid>
                                            </Border>
                                        </TreeDataTemplate>
                                    </TreeView.ItemTemplate>
                                </TreeView>
                            </ScrollViewer>
                        </Grid>
                    </TabItem>

                    <!-- Tab 3: Components -->
                    <TabItem Header="Components">
                        <Grid RowDefinitions="Auto,*" Margin="12,8,12,0">
                            <StackPanel Grid.Row="0"
                                        Orientation="Horizontal" Spacing="6"
                                        Margin="0,0,0,8">
                                <Button Content="Show All" FontSize="10"
                                        Background="{DynamicResource ThemeBgButton}"
                                        Foreground="{DynamicResource ThemeTextSecondary}"
                                        Padding="8,3" CornerRadius="3"
                                        Click="OnShowAllComponentsClick" />
                                <Button Content="Hide All" FontSize="10"
                                        Background="{DynamicResource ThemeBgButton}"
                                        Foreground="{DynamicResource ThemeTextSecondary}"
                                        Padding="8,3" CornerRadius="3"
                                        Click="OnHideAllComponentsClick" />
                                <Button Content="◎" FontSize="14"
                                        Background="{DynamicResource ThemeAccentRed}"
                                        Foreground="{DynamicResource ThemeBgViewport}"
                                        Padding="8,1" CornerRadius="3"
                                        ToolTip.Tip="Radial component toggle"
                                        Click="OnRadialToggleClick" />
                            </StackPanel>
                            <ScrollViewer Grid.Row="1">
                                <ItemsControl ItemsSource="{Binding Components}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ComponentViewModel">
                                            <Border CornerRadius="4" Margin="0,1"
                                                    Padding="6,4"
                                                    Background="{DynamicResource ThemeBgItemRow}">
                                                <Grid ColumnDefinitions="Auto,*">
                                                    <CheckBox Grid.Column="0"
                                                              IsChecked="{Binding IsVisible}"
                                                              FontSize="12"
                                                              VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding Name}"
                                                               Foreground="{DynamicResource ThemeTextPrimary}"
                                                               FontSize="12"
                                                               VerticalAlignment="Center"
                                                               Margin="6,0,0,0"
                                                               TextTrimming="CharacterEllipsis" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </TabItem>

                    <!-- Tab 4: Animations -->
                    <TabItem Header="Animations"
                             IsVisible="{Binding HasAnimations}">
                        <Grid RowDefinitions="Auto,Auto,*" Margin="12,8,12,12">
                            <!-- Animation list -->
                            <ScrollViewer Grid.Row="0" MaxHeight="160" Margin="0,0,0,8">
                                <ListBox x:Name="AnimationListBox"
                                         ItemsSource="{Binding AnimationNames}"
                                         SelectedItem="{Binding CurrentAnimationName}"
                                         Background="Transparent"
                                         Foreground="{DynamicResource ThemeTextPrimary}"
                                         BorderThickness="0" FontSize="12"
                                         DoubleTapped="OnAnimationDoubleTapped">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}"
                                                       Padding="6,3" />
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                    <ListBox.Styles>
                                        <Style Selector="ListBoxItem">
                                            <Setter Property="Background"
                                                    Value="Transparent" />
                                            <Setter Property="CornerRadius" Value="4" />
                                        </Style>
                                        <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
                                            <Setter Property="Background"
                                                    Value="{DynamicResource ThemeAnimSelected}" />
                                            <Setter Property="CornerRadius" Value="4" />
                                        </Style>
                                        <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                                            <Setter Property="Background"
                                                    Value="{DynamicResource ThemeBgHover}" />
                                            <Setter Property="CornerRadius" Value="4" />
                                        </Style>
                                    </ListBox.Styles>
                                </ListBox>
                            </ScrollViewer>

                            <!-- Transport controls -->
                            <Border Grid.Row="1" Background="{DynamicResource ThemeBgCard}"
                                    CornerRadius="6" Padding="8"
                                    Margin="0,0,0,8"
                                    IsVisible="{Binding !!CurrentAnimationName}">
                                <StackPanel Spacing="6">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <Button Width="32" Height="32"
                                                Content="&#x25C0;" FontSize="12"
                                                Background="{DynamicResource ThemeBgButton}"
                                                Foreground="{DynamicResource ThemeTextSecondary}"
                                                IsEnabled="{Binding CanPreviousAnimation}"
                                                Click="OnPreviousAnimationClick"
                                                CornerRadius="4" />
                                        <Border Grid.Column="1"
                                                Background="{DynamicResource ThemeAnimTransport}"
                                                CornerRadius="4"
                                                Padding="8,4" Margin="8,0">
                                            <StackPanel>
                                                <TextBlock Text="{Binding CurrentAnimationName, FallbackValue=''}"
                                                           Foreground="{DynamicResource ThemeTextPrimary}" FontSize="12"
                                                           FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding AnimationTimeText, FallbackValue=''}"
                                                           Foreground="{DynamicResource ThemeTextLabel}" FontSize="10"
                                                           IsVisible="{Binding !!AnimationTimeText}" />
                                            </StackPanel>
                                        </Border>
                                        <Button Grid.Column="2" Width="32" Height="32"
                                                Content="&#x25B6;" FontSize="12"
                                                Background="{DynamicResource ThemeBgButton}"
                                                Foreground="{DynamicResource ThemeTextSecondary}"
                                                IsEnabled="{Binding CanNextAnimation}"
                                                Click="OnNextAnimationClick"
                                                CornerRadius="4" />
                                    </Grid>

                                    <Grid ColumnDefinitions="Auto,*"
                                          IsVisible="{Binding !!CurrentAnimationName}">
                                        <Button x:Name="PlayPauseBtn" Width="38" Height="30"
                                                Content="&#x25B6;"
                                                Background="{DynamicResource ThemeAccentRed}"
                                                Foreground="{DynamicResource ThemeBgViewport}"
                                                FontSize="14"
                                                Click="OnPlayPauseClick" CornerRadius="4" />
                                        <ProgressBar Grid.Column="1" Height="4"
                                                      Value="{Binding AnimationProgress}"
                                                      Maximum="1.0" Margin="10,0"
                                                      VerticalAlignment="Center" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Empty state -->
                            <TextBlock Grid.Row="2" Text="No animation selected"
                                       Foreground="{DynamicResource ThemeTextMuted}" FontSize="11"
                                       HorizontalAlignment="Center"
                                       IsVisible="{Binding !CurrentAnimationName}" />
                        </Grid>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>

        <!-- Error Bar -->
        <Border Grid.Row="1"
                Background="{DynamicResource ThemeErrorBg}" Padding="10,8"
                IsVisible="{Binding HasError}">
            <Grid RowDefinitions="*,Auto">
                <ScrollViewer MaxHeight="180">
                    <TextBlock Text="{Binding ErrorDetail}"
                               Foreground="{DynamicResource ThemeErrorText}" FontSize="11"
                               FontFamily="Cascadia Code,Consolas,monospace"
                               TextWrapping="Wrap" />
                </ScrollViewer>
                <Button Grid.Row="1" Content="Dismiss" HorizontalAlignment="Right"
                        Background="{DynamicResource ThemeAccentRed}"
                        Foreground="{DynamicResource ThemeBgViewport}" FontSize="11"
                        FontWeight="SemiBold"
                        Padding="14,4" CornerRadius="4"
                        Click="OnCopyErrorClick" Margin="0,6,0,0" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
