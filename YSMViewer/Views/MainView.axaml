<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:YSMViewer.ViewModels"
             xmlns:a="https://sunce.tech/aura3d"
             xmlns:v="clr-namespace:YSMViewer.Views"
             xmlns:svg="clr-namespace:Avalonia.Svg.Skia;assembly=Svg.Controls.Skia.Avalonia"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
             x:Class="YSMViewer.Views.MainView"
             x:DataType="vm:MainViewModel"
             DragDrop.AllowDrop="True">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <UserControl.Resources>
        <vm:NotificationIconConverter x:Key="NotificationIconConverter" />
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="Button">
            <Setter Property="Background" Value="{DynamicResource ThemeBgButton}" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextSecondary}" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="Button:pointerover">
            <Setter Property="Background" Value="{DynamicResource ThemeBgHover}" />
        </Style>
        <Style Selector="Button:pressed">
            <Setter Property="Background" Value="{DynamicResource ThemeBgActive}" />
        </Style>
        <Style Selector="Button:disabled">
            <Setter Property="Opacity" Value="0.4" />
        </Style>
        <Style Selector="Expander">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style Selector="Expander /template/ ToggleButton#ExpanderHeader">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="12,10" />
        </Style>
        <Style Selector="Expander /template/ ToggleButton#ExpanderHeader:pointerover">
            <Setter Property="Background" Value="{DynamicResource ThemeBgHover}" />
        </Style>
        <Style Selector="ProgressBar">
            <Setter Property="Foreground" Value="{DynamicResource ThemeAccentRed}" />
            <Setter Property="Background" Value="{DynamicResource ThemeBorder}" />
        </Style>
    </UserControl.Styles>

    <Panel>
    <Grid RowDefinitions="Auto,*,Auto" Background="{DynamicResource ThemeBgViewport}">

        <!-- ===== Top Bar ===== -->
        <Border Grid.Row="0" Background="{DynamicResource ThemeBgSurface}"
                BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto" MinHeight="48" Margin="16,0">
                <Button x:Name="OpenButton" Content="Open File"
                        Click="OnOpenButtonClick"
                        IsEnabled="{Binding !IsLoading}"
                        Background="{DynamicResource ThemeAccentRed}" Foreground="White"
                        FontSize="13" Padding="16,7" CornerRadius="6" FontWeight="SemiBold" />
                <Border Grid.Column="1" IsVisible="{Binding IsLoading}" Margin="12,0,0,0"
                        VerticalAlignment="Center">
                    <ProgressBar Width="80" Height="3" IsIndeterminate="True" />
                </Border>
                <TextBlock Grid.Column="2" Text="{Binding StatusText}"
                           Foreground="{DynamicResource ThemeTextSecondary}" FontSize="12"
                           VerticalAlignment="Center" Margin="16,0,0,0"
                           TextTrimming="CharacterEllipsis" />
                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8"
                            VerticalAlignment="Center">
                    <Button x:Name="LanguageButton"
                            Width="36" Height="36" Padding="0" CornerRadius="6"
                            ToolTip.Tip="Switch language"
                            Click="OnLanguageButtonClick">
                        <Image x:Name="LangSvgImage" Width="20" Height="20" />
                    </Button>
                    <Button x:Name="ThemeToggleButton"
                            Click="OnThemeToggleClick"
                            Width="36" Height="36" Padding="0" CornerRadius="6"
                            ToolTip.Tip="Toggle theme">
                        <Image x:Name="ThemeSvgImage" Width="20" Height="20" />
                    </Button>
                    <Button x:Name="GitHubButton"
                            Click="OnGitHubClick"
                            Width="36" Height="36" Padding="0" CornerRadius="6"
                            ToolTip.Tip="View on GitHub">
                        <Image x:Name="GitHubSvgImage" Width="20" Height="20" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== Main Content ===== -->
        <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,*,4,310">

            <!-- Folder Browser -->
            <Border Grid.Column="0" Background="{DynamicResource ThemeBgSurface}"
                    BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,0,1,0"
                    IsVisible="{Binding IsDesktop}"
                    MinWidth="200" MaxWidth="320">
                <v:FolderBrowserView DataContext="{Binding FolderBrowser}" Margin="8" Width="240" />
            </Border>

            <GridSplitter Grid.Column="1" Width="4"
                          IsVisible="{Binding IsDesktop}"
                          Background="{DynamicResource ThemeBorder}"
                          ResizeDirection="Columns" />

            <!-- Viewport -->
            <Panel Grid.Column="2" x:Name="ViewportPanel">
                <a:Aura3DView x:Name="AuraView"
                              SceneInitialized="OnSceneInitialized"
                              SceneUpdated="OnSceneUpdated" />

                <!-- Gizmo overlay -->
                <Border x:Name="GizmoBorder"
                        Width="100" Height="100"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Margin="0,0,16,16"
                        Background="Transparent"
                        CornerRadius="8"
                        PointerEntered="OnGizmoPointerEntered"
                        PointerExited="OnGizmoPointerExited"
                        PointerPressed="OnGizmoPointerPressed"
                        PointerReleased="OnGizmoPointerReleased">
                    <a:Aura3DView x:Name="GizmoView"
                                  IsHitTestVisible="False"
                                  SceneInitialized="OnGizmoSceneInitialized" />
                </Border>

                <!-- Empty state overlay -->
                <Border IsVisible="{Binding !HasModel}"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        CornerRadius="16" Padding="48,40"
                        Background="{DynamicResource ThemeBgSurface}">
                    <StackPanel HorizontalAlignment="Center" Spacing="16">
                        <TextBlock Text="YSMViewer" FontSize="36" FontWeight="Bold"
                                   Foreground="{DynamicResource ThemeTextPrimary}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="Open a .ysm file or drag and drop here"
                                   FontSize="15" Foreground="{DynamicResource ThemeTextSecondary}"
                                   HorizontalAlignment="Center" />
                        <Button Content="Open File" Click="OnOpenButtonClick"
                                HorizontalAlignment="Center"
                                Background="{DynamicResource ThemeAccentRed}" Foreground="White"
                                FontSize="14" Padding="24,10" CornerRadius="8" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>

                <!-- Drag-and-drop overlay -->
                <Border x:Name="DragOverlay"
                        IsVisible="False"
                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                        Background="{DynamicResource ThemeBgSurface}"
                        Opacity="0.92"
                        CornerRadius="12" Margin="8"
                        BorderBrush="{DynamicResource ThemeAccent}" BorderThickness="2">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                        <TextBlock Text="Drop to open" FontSize="22" FontWeight="SemiBold"
                                   Foreground="{DynamicResource ThemeAccent}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text=".ysm file" FontSize="14"
                                   Foreground="{DynamicResource ThemeTextSecondary}"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- Error overlay -->
                <Border IsVisible="{Binding HasError}"
                        HorizontalAlignment="Center" VerticalAlignment="Bottom"
                        Margin="16" CornerRadius="10" Padding="20,16"
                        MaxWidth="560"
                        Background="{DynamicResource ThemeErrorBg}" Opacity="0.95">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Error" FontWeight="Bold" FontSize="15"
                                   Foreground="{DynamicResource ThemeErrorText}" />
                        <ScrollViewer MaxHeight="140">
                            <SelectableTextBlock Text="{Binding ErrorDetail}" FontSize="11"
                                                  Foreground="{DynamicResource ThemeErrorText}" Opacity="0.8" TextWrapping="Wrap" />
                        </ScrollViewer>
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                            <Button Content="Copy" Click="OnCopyErrorClick"
                                    Background="{DynamicResource ThemeBgButton}" Foreground="{DynamicResource ThemeTextSecondary}"
                                    Padding="12,4" CornerRadius="4" FontSize="11" />
                            <Button Content="Dismiss" Click="OnDismissErrorClick"
                                    Background="{DynamicResource ThemeAccentRed}" Foreground="White"
                                    Padding="14,4" CornerRadius="4" FontSize="11" FontWeight="SemiBold" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Panel>

            <!-- Splitter -->
            <GridSplitter Grid.Column="3" Width="4"
                          Background="{DynamicResource ThemeBorder}"
                          ResizeDirection="Columns" />

            <!-- Side Panel -->
            <Border Grid.Column="4" IsVisible="{Binding HasModel}"
                    Background="{DynamicResource ThemeBgSurface}"
                    BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1,0,0,0"
                    MinWidth="240" MaxWidth="500">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="2" Margin="0,4">

                        <!-- Info Section -->
                        <Expander IsExpanded="True" Padding="0">
                            <Expander.Header>
                                <TextBlock Text="Info" FontWeight="SemiBold" FontSize="13"
                                           Foreground="{DynamicResource ThemeTextPrimary}" />
                            </Expander.Header>
                            <StackPanel Spacing="10" Margin="12,8">
                                <TextBlock Text="{Binding ModelDisplayName}"
                                           FontSize="18" FontWeight="Bold"
                                           Foreground="{DynamicResource ThemeTextPrimary}"
                                           TextWrapping="Wrap" />
                                <Border Height="1" Background="{DynamicResource ThemeDivider}" />
                                <StackPanel Spacing="6">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="Version" FontSize="11"
                                                   Foreground="{DynamicResource ThemeTextMuted}" Width="60" />
                                        <TextBlock Text="{Binding ModelVersion}"
                                                   FontSize="12" Foreground="{DynamicResource ThemeTextSecondary}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="8"
                                                IsVisible="{Binding HasModelAuthors}">
                                        <TextBlock Text="Authors" FontSize="11"
                                                   Foreground="{DynamicResource ThemeTextMuted}" Width="60" />
                                        <TextBlock Text="{Binding ModelAuthors}"
                                                   FontSize="12" Foreground="{DynamicResource ThemeTextSecondary}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="8"
                                                IsVisible="{Binding HasModelLicense}">
                                        <TextBlock Text="License" FontSize="11"
                                                   Foreground="{DynamicResource ThemeTextMuted}" Width="60" />
                                        <TextBlock Text="{Binding ModelLicense}"
                                                   FontSize="12" Foreground="{DynamicResource ThemeTextSecondary}" />
                                        <Border Background="{DynamicResource ThemeAccentGreen}" CornerRadius="3"
                                                Padding="5,1" VerticalAlignment="Center"
                                                IsVisible="{Binding IsFreeModel}">
                                            <TextBlock Text="FREE" FontSize="9" FontWeight="Bold"
                                                       Foreground="{DynamicResource ThemeBgViewport}" />
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock Text="{Binding ModelTips}"
                                           FontSize="11" Foreground="{DynamicResource ThemeTextLabel}"
                                           TextWrapping="Wrap"
                                           IsVisible="{Binding HasModelTips}" />
                            </StackPanel>
                        </Expander>

                        <!-- Components Section -->
                        <Expander IsExpanded="False" Padding="0">
                            <Expander.Header>
                                <TextBlock Text="Components" FontWeight="SemiBold" FontSize="13"
                                           Foreground="{DynamicResource ThemeTextPrimary}" />
                            </Expander.Header>
                            <StackPanel Spacing="6" Margin="12,8">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Button Content="Show All" FontSize="10"
                                            Click="OnShowAllComponentsClick"
                                            Padding="8,3" CornerRadius="4" />
                                    <Button Content="Hide All" FontSize="10"
                                            Click="OnHideAllComponentsClick"
                                            Padding="8,3" CornerRadius="4" />
                                </StackPanel>
                                <ItemsControl ItemsSource="{Binding Components}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ComponentViewModel">
                                            <Border CornerRadius="4" Margin="0,2"
                                                    Padding="8,4"
                                                    Background="{DynamicResource ThemeBgElevated}">
                                                <Grid ColumnDefinitions="Auto,*">
                                                    <CheckBox Grid.Column="0"
                                                              IsChecked="{Binding IsVisible}"
                                                              FontSize="12" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding Name}"
                                                               Foreground="{DynamicResource ThemeTextPrimary}"
                                                               FontSize="12" VerticalAlignment="Center"
                                                               Margin="6,0,0,0"
                                                               TextTrimming="CharacterEllipsis" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Expander>

                        <!-- Bones Section -->
                        <Expander IsExpanded="False" Padding="0">
                            <Expander.Header>
                                <TextBlock Text="Bones" FontWeight="SemiBold" FontSize="13"
                                           Foreground="{DynamicResource ThemeTextPrimary}" />
                            </Expander.Header>
                            <StackPanel Spacing="6" Margin="12,8">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Button Content="Expand All" FontSize="10"
                                            Click="OnExpandAllBonesClick"
                                            Padding="8,3" CornerRadius="4" />
                                    <Button Content="Collapse All" FontSize="10"
                                            Click="OnCollapseAllBonesClick"
                                            Padding="8,3" CornerRadius="4" />
                                </StackPanel>
                                <TreeView ItemsSource="{Binding BoneTreeRoots}"
                                          Background="Transparent" BorderThickness="0"
                                          Foreground="{DynamicResource ThemeTextPrimary}" FontSize="12">
                                    <TreeView.Styles>
                                        <Style Selector="TreeViewItem">
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="Margin" Value="0" />
                                        </Style>
                                    </TreeView.Styles>
                                    <TreeView.ItemTemplate>
                                        <TreeDataTemplate ItemsSource="{Binding Children}"
                                                          x:DataType="vm:BoneTreeItemViewModel">
                                            <Grid ColumnDefinitions="Auto,*,Auto">
                                                <TextBlock Grid.Column="0" Text="{Binding Icon}" FontSize="12"
                                                           VerticalAlignment="Center" Margin="0,0,4,0" />
                                                <TextBlock Grid.Column="1" Text="{Binding Name}"
                                                           Foreground="{DynamicResource ThemeTextPrimary}"
                                                           FontSize="12" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" />
                                                <ToggleButton Grid.Column="2" Width="24" Height="24"
                                                              IsChecked="{Binding IsVisible, Mode=TwoWay}"
                                                              CornerRadius="4" Padding="0" Margin="4,0,0,0"
                                                              HorizontalContentAlignment="Center"
                                                              VerticalContentAlignment="Center">
                                                    <ToggleButton.Styles>
                                                        <Style Selector="ToggleButton">
                                                            <Setter Property="Background" Value="{DynamicResource ThemeToggleDefault}" />
                                                        </Style>
                                                        <Style Selector="ToggleButton:checked">
                                                            <Setter Property="Background" Value="{DynamicResource ThemeToggleChecked}" />
                                                        </Style>
                                                        <Style Selector="ToggleButton:unchecked">
                                                            <Setter Property="Background" Value="{DynamicResource ThemeToggleUnchecked}" />
                                                        </Style>
                                                    </ToggleButton.Styles>
                                                    <TextBlock Text="◉" FontSize="11"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" />
                                                </ToggleButton>
                                            </Grid>
                                        </TreeDataTemplate>
                                    </TreeView.ItemTemplate>
                                </TreeView>
                            </StackPanel>
                        </Expander>

                        <!-- Textures Section -->
                        <Expander IsExpanded="False" Padding="0"
                                  IsVisible="{Binding HasTextures}">
                            <Expander.Header>
                                <TextBlock Text="Textures" FontWeight="SemiBold" FontSize="13"
                                           Foreground="{DynamicResource ThemeTextPrimary}" />
                            </Expander.Header>
                            <StackPanel Spacing="6" Margin="12,8">
                                <TextBlock Text="Image resources in this YSM file"
                                           FontSize="11" Foreground="{DynamicResource ThemeTextMuted}" />
                                <ItemsControl ItemsSource="{Binding TextureItems}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:TextureItemViewModel">
                                            <Border CornerRadius="6" Margin="0,0,0,6"
                                                    Padding="8" Background="{DynamicResource ThemeBgElevated}">
                                                <Grid ColumnDefinitions="56,*,Auto">
                                                    <Border Grid.Column="0" Width="56" Height="56"
                                                            CornerRadius="4"
                                                            Background="{DynamicResource ThemeBgViewport}"
                                                            ClipToBounds="True">
                                                        <Image Source="{Binding Thumbnail}"
                                                               Stretch="UniformToFill"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" />
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Margin="8,0,0,0"
                                                                VerticalAlignment="Center" Spacing="2">
                                                        <TextBlock Text="{Binding Name}"
                                                                   FontSize="12" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource ThemeTextPrimary}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                            <TextBlock Text="{Binding DimensionsDisplay}"
                                                                       FontSize="10" Foreground="{DynamicResource ThemeTextMuted}" />
                                                            <TextBlock Text="{Binding SizeDisplay}"
                                                                       FontSize="10" Foreground="{DynamicResource ThemeTextMuted}" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                    <Border Grid.Column="2" CornerRadius="3" Padding="5,2"
                                                            VerticalAlignment="Center"
                                                            Background="{Binding BadgeBrush}">
                                                        <TextBlock Text="{Binding Category}" FontSize="10"
                                                                   Foreground="White" FontWeight="SemiBold" />
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Expander>

                        <!-- Animations Section -->
                        <Expander IsExpanded="True" Padding="0"
                                  IsVisible="{Binding HasAnimations}">
                            <Expander.Header>
                                <TextBlock Text="Animations" FontWeight="SemiBold" FontSize="13"
                                           Foreground="{DynamicResource ThemeTextPrimary}" />
                            </Expander.Header>
                            <StackPanel Spacing="6" Margin="12,8">
                                <ListBox x:Name="AnimationListBox"
                                         ItemsSource="{Binding AnimationNames}"
                                         SelectedItem="{Binding CurrentAnimationName}"
                                         Background="Transparent" BorderThickness="0"
                                         Foreground="{DynamicResource ThemeTextPrimary}" FontSize="12"
                                         SelectionChanged="OnAnimationSelectionChanged"
                                         MaxHeight="200">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" Padding="6,4" />
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                    <ListBox.Styles>
                                        <Style Selector="ListBoxItem">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="CornerRadius" Value="4" />
                                        </Style>
                                        <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
                                            <Setter Property="Background" Value="{DynamicResource ThemeAnimSelected}" />
                                            <Setter Property="CornerRadius" Value="4" />
                                        </Style>
                                        <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                                            <Setter Property="Background" Value="{DynamicResource ThemeBgHover}" />
                                            <Setter Property="CornerRadius" Value="4" />
                                        </Style>
                                    </ListBox.Styles>
                                </ListBox>
                            </StackPanel>
                        </Expander>

                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ===== Bottom Bar ===== -->
        <Border Grid.Row="2" Background="{DynamicResource ThemeBgSurface}"
                BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,1,0,0"
                Padding="16,0" Height="48">
            <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto"
                  VerticalAlignment="Center">
                <!-- Animation controls (visible when animations exist) -->
                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center"
                            IsVisible="{Binding HasAnimations}">
                    <Button x:Name="PrevAnimBtn"
                            IsEnabled="{Binding CanPreviousAnimation}"
                            Click="OnPreviousAnimationClick" CornerRadius="4"
                            Width="32" Height="32" Padding="0">
                        <PathIcon Data="M2 16 L14 8 L14 24 Z M14 16 L26 8 L26 24 Z"
                                  Foreground="{DynamicResource ThemeTextSecondary}" />
                    </Button>
                    <Button x:Name="PlayPauseBtn"
                            Click="OnPlayPauseClick" CornerRadius="4"
                            Background="{DynamicResource ThemeAccentRed}" Foreground="White"
                            Width="36" Height="36" Padding="0">
                        <PathIcon x:Name="PlayPauseIcon"
                                  Data="M8 4 L8 28 L24 16 Z"
                                  Foreground="White" />
                    </Button>
                    <Button x:Name="NextAnimBtn"
                            IsEnabled="{Binding CanNextAnimation}"
                            Click="OnNextAnimationClick" CornerRadius="4"
                            Width="32" Height="32" Padding="0">
                        <PathIcon Data="M2 8 L14 16 L2 24 Z M14 8 L26 16 L14 24 Z"
                                  Foreground="{DynamicResource ThemeTextSecondary}" />
                    </Button>
                    <Button Click="OnStopAnimationClick" CornerRadius="4"
                            Width="32" Height="32" Padding="0"
                            ToolTip.Tip="Stop and reset animation">
                        <PathIcon Data="M6 6 L6 26 L26 26 L26 6 Z"
                                  Foreground="{DynamicResource ThemeAccentRed}" />
                    </Button>
                </StackPanel>

                <!-- Animation name + progress (visible when animations exist) -->
                <Border Grid.Column="1" Background="{DynamicResource ThemeAnimTransport}"
                        CornerRadius="4" Padding="10,4" Margin="12,0,0,0"
                        VerticalAlignment="Center"
                        IsVisible="{Binding HasAnimations}">
                    <TextBlock Text="{Binding CurrentAnimationName, FallbackValue=''}"
                               Foreground="{DynamicResource ThemeTextPrimary}" FontSize="13"
                               FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                </Border>

                <!-- Progress + time (column 3, visible when animations exist) -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8"
                            IsVisible="{Binding HasAnimations}" VerticalAlignment="Center">
                    <ProgressBar Value="{Binding AnimationProgress}" Maximum="1.0"
                                 Height="4" Width="120" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding AnimationTimeText, FallbackValue=''}"
                               Foreground="{DynamicResource ThemeTextMuted}" FontSize="11"
                               VerticalAlignment="Center" />
                </StackPanel>

                <!-- Spacer (column 4) -->

                <!-- Camera view buttons -->
                <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <Button Click="OnCameraFrontClick" CornerRadius="4"
                            Width="32" Height="32" Padding="0"
                            ToolTip.Tip="Front view">
                        <Image x:Name="CameraFrontImg" Width="20" Height="20" />
                    </Button>
                    <Button Click="OnCameraLeftClick" CornerRadius="4"
                            Width="32" Height="32" Padding="0"
                            ToolTip.Tip="Left view">
                        <Image x:Name="CameraLeftImg" Width="20" Height="20" />
                    </Button>
                    <Button Click="OnCameraTopClick" CornerRadius="4"
                            Width="32" Height="32" Padding="0"
                            ToolTip.Tip="Top view">
                        <Image x:Name="CameraTopImg" Width="20" Height="20" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
</Grid>

    <!-- Toast overlay -->
    <ItemsControl ItemsSource="{Binding Notifications.Notifications}"
                  HorizontalAlignment="Right" VerticalAlignment="Top"
                  Margin="16,56,16,0" MaxWidth="380">
        <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:NotificationViewModel">
                <Border CornerRadius="8" Padding="12,8" Margin="0,0,0,8"
                        Background="{DynamicResource ThemeBgElevated}"
                        BorderBrush="{DynamicResource ThemeAccent}" BorderThickness="1">
                    <Grid ColumnDefinitions="Auto,*">
                        <TextBlock Grid.Column="0" Text="{Binding Type, Converter={StaticResource NotificationIconConverter}}"
                                   FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding Message}" TextWrapping="Wrap"
                                   Foreground="{DynamicResource ThemeTextPrimary}" FontSize="12"
                                   VerticalAlignment="Center" />
                    </Grid>
                </Border>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</Panel>
</UserControl>