<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:YSMViewer"
             x:Class="YSMViewer.App"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>

    <Application.Resources>
        <ResourceDictionary>
            <!-- ============================================ -->
            <!-- Theme Colors — change values here to switch  -->
            <!-- ============================================ -->

            <!-- Backgrounds -->
            <Color x:Key="ThemeBgViewport">#1a1b26</Color>
            <Color x:Key="ThemeBgPanel">#16161e</Color>
            <Color x:Key="ThemeBgCard">#1f2335</Color>
            <Color x:Key="ThemeBgHover">#24283b</Color>
            <Color x:Key="ThemeBgButton">#24283b</Color>
            <Color x:Key="ThemeBgItemRow">#1f2335</Color>

            <!-- Text -->
            <Color x:Key="ThemeTextPrimary">#c0caf5</Color>
            <Color x:Key="ThemeTextSecondary">#a9b1d6</Color>
            <Color x:Key="ThemeTextMuted">#565f89</Color>
            <Color x:Key="ThemeTextLabel">#787c99</Color>

            <!-- Accents -->
            <Color x:Key="ThemeAccent">#7aa2f7</Color>
            <Color x:Key="ThemeAccentGreen">#9ece6a</Color>
            <Color x:Key="ThemeAccentRed">#f7768e</Color>

            <!-- Borders & Splitters -->
            <Color x:Key="ThemeBorder">#3b4261</Color>

            <!-- Eye Toggle States -->
            <Color x:Key="ThemeToggleChecked">#2e4a3a</Color>
            <Color x:Key="ThemeToggleUnchecked">#3a2020</Color>
            <Color x:Key="ThemeToggleDefault">Transparent</Color>

            <!-- Error Bar -->
            <Color x:Key="ThemeErrorBg">#2d1016</Color>
            <Color x:Key="ThemeErrorText">#f7768e</Color>

            <!-- Tab -->
            <Color x:Key="ThemeTabActiveBg">#1f2335</Color>
            <Color x:Key="ThemeTabHoverBg">#24283b</Color>

            <!-- Tree Arrow -->
            <Color x:Key="ThemeTreeArrow">#7aa2f7</Color>

            <!-- Animation -->
            <Color x:Key="ThemeAnimSelected">#2a3a5f</Color>
            <Color x:Key="ThemeAnimTransport">#16161e</Color>

            <!-- Info Tab -->
            <Color x:Key="ThemeDivider">#24283b</Color>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
    </Application.Styles>
</Application>
