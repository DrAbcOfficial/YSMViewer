<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:YSMViewer.ViewModels;assembly=YSMViewer"
             xmlns:v="clr-namespace:YSMViewer.Views;assembly=YSMViewer"
             xmlns:svg="clr-namespace:Avalonia.Svg.Skia;assembly=Svg.Controls.Skia.Avalonia"
             xmlns:shared="clr-namespace:YSMViewer.Views.Shared;assembly=YSMViewer"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
             x:Class="YSMViewer.Desktop.Views.MainView"
             x:DataType="vm:MainViewModel"
             DragDrop.AllowDrop="True">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <UserControl.Resources>
        <vm:NotificationIconConverter x:Key="NotificationIconConverter" />
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="Button">
            <Setter Property="Background" Value="{DynamicResource ThemeBgButton}" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextSecondary}" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="Button:pointerover">
            <Setter Property="Background" Value="{DynamicResource ThemeBgHover}" />
        </Style>
        <Style Selector="Button:pressed">
            <Setter Property="Background" Value="{DynamicResource ThemeBgActive}" />
        </Style>
        <Style Selector="Button:disabled">
            <Setter Property="Opacity" Value="0.4" />
        </Style>
        <Style Selector="Expander">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style Selector="Expander /template/ ToggleButton#ExpanderHeader">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="12,10" />
        </Style>
        <Style Selector="Expander /template/ ToggleButton#ExpanderHeader:pointerover">
            <Setter Property="Background" Value="{DynamicResource ThemeBgHover}" />
        </Style>
        <Style Selector="ProgressBar">
            <Setter Property="Foreground" Value="{DynamicResource ThemeAccentRed}" />
            <Setter Property="Background" Value="{DynamicResource ThemeBorder}" />
        </Style>
    </UserControl.Styles>

    <Panel>
    <Grid RowDefinitions="Auto,*,Auto" Background="{DynamicResource ThemeBgViewport}">

        <shared:ModelToolBar Grid.Row="0" DataContext="{Binding}" />

        <!-- ===== Main Content ===== -->
        <Grid Grid.Row="1" x:Name="MainContentGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" MinWidth="0" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="300" MinWidth="0" />
            </Grid.ColumnDefinitions>

            <!-- Folder Browser -->
            <Border Grid.Column="0" Background="{DynamicResource ThemeBgSurface}"
                    BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,0,1,0"
                    IsVisible="{Binding IsDesktop}">
                <Grid RowDefinitions="Auto,*">
                    <Border Grid.Row="0" Padding="8,6" Background="{DynamicResource ThemeBgElevated}">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="Files" FontWeight="SemiBold" FontSize="12"
                                       Foreground="{DynamicResource ThemeTextPrimary}"
                                       VerticalAlignment="Center" />
                            <Button Grid.Column="1" x:Name="LeftPanelToggleBtn"
                                    Width="24" Height="24" Padding="0"
                                    CornerRadius="4" Background="Transparent"
                                    ToolTip.Tip="Collapse panel"
                                    Click="OnToggleLeftPanelClick">
                                <svg:Svg x:Name="LeftPanelToggleIcon"
                                         Path="avares://YSMViewer/Assets/svg/chevron-left.svg"
                                         Stretch="Uniform" Width="14" Height="14" />
                            </Button>
                        </Grid>
                    </Border>
                    <v:FolderBrowserView Grid.Row="1"
                                         DataContext="{Binding FolderBrowser}" />
                </Grid>
            </Border>

            <!-- Left Splitter -->
            <GridSplitter Grid.Column="1" Width="4"
                          Background="Transparent"
                          ResizeBehavior="PreviousAndNext"
                          IsVisible="{Binding IsDesktop}" />

            <!-- Viewport -->
            <Panel Grid.Column="2" x:Name="ViewportPanel">
                <ContentControl Content="{Binding Renderer.View}" />

                <!-- Gizmo overlay -->
                <Border x:Name="GizmoBorder"
                        Width="100" Height="100"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Margin="0,0,16,16"
                        Background="Transparent"
                        CornerRadius="8"
                        PointerEntered="OnGizmoPointerEntered"
                        PointerExited="OnGizmoPointerExited"
                        PointerPressed="OnGizmoPointerPressed"
                        PointerReleased="OnGizmoPointerReleased">
                    <ContentControl x:Name="GizmoHost" />
                </Border>

                <!-- Floating restore buttons for collapsed panels -->
                <Border x:Name="LeftRestoreBtn"
                        HorizontalAlignment="Left" VerticalAlignment="Center"
                        Margin="0,0,0,0" IsHitTestVisible="True"
                        Background="{DynamicResource ThemeBgSurface}"
                        BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,1,1,1"
                        CornerRadius="0,6,6,0" Padding="0"
                        Width="20" Height="48"
                        IsVisible="{Binding !IsLeftPanelVisible}">
                    <Border.Styles>
                        <Style Selector="Border#LeftRestoreBtn">
                            <Setter Property="Opacity" Value="0.6" />
                        </Style>
                        <Style Selector="Border#LeftRestoreBtn:pointerover">
                            <Setter Property="Opacity" Value="1" />
                        </Style>
                    </Border.Styles>
                    <Button Width="20" Height="48" Padding="0"
                            CornerRadius="0,6,6,0" Background="Transparent"
                            Click="OnToggleLeftPanelClick">
                        <svg:Svg Path="avares://YSMViewer/Assets/svg/chevron-right.svg"
                                 Stretch="Uniform" Width="12" Height="12" />
                    </Button>
                </Border>

                <Border x:Name="RightRestoreBtn"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Margin="0,0,0,0" IsHitTestVisible="True"
                        Background="{DynamicResource ThemeBgSurface}"
                        BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1,1,0,1"
                        CornerRadius="6,0,0,6" Padding="0"
                        Width="20" Height="48"
                        IsVisible="{Binding !IsRightPanelVisible}">
                    <Border.Styles>
                        <Style Selector="Border#RightRestoreBtn">
                            <Setter Property="Opacity" Value="0.6" />
                        </Style>
                        <Style Selector="Border#RightRestoreBtn:pointerover">
                            <Setter Property="Opacity" Value="1" />
                        </Style>
                    </Border.Styles>
                    <Button Width="20" Height="48" Padding="0"
                            CornerRadius="6,0,0,6" Background="Transparent"
                            Click="OnToggleRightPanelClick">
                        <svg:Svg Path="avares://YSMViewer/Assets/svg/chevron-left.svg"
                                 Stretch="Uniform" Width="12" Height="12" />
                    </Button>
                </Border>

                <!-- Empty state overlay -->
                <Border IsVisible="{Binding !HasModel}"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        CornerRadius="16" Padding="48,40"
                        Background="{DynamicResource ThemeBgSurface}">
                    <StackPanel HorizontalAlignment="Center" Spacing="16">
                        <TextBlock Text="YSMViewer" FontSize="36" FontWeight="Bold"
                                   Foreground="{DynamicResource ThemeTextPrimary}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding LocEmptyState}"
                                   FontSize="15" Foreground="{DynamicResource ThemeTextSecondary}"
                                   HorizontalAlignment="Center" />
                        <Button Content="{Binding LocOpenFile}" Click="OnOpenButtonClick"
                                HorizontalAlignment="Center"
                                Background="{DynamicResource ThemeAccentRed}" Foreground="White"
                                FontSize="14" Padding="24,10" CornerRadius="8" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>

                <!-- Drag-and-drop overlay -->
                <Border x:Name="DragOverlay"
                        IsVisible="False"
                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                        Background="{DynamicResource ThemeBgSurface}"
                        Opacity="0.92"
                        CornerRadius="12" Margin="8"
                        BorderBrush="{DynamicResource ThemeAccent}" BorderThickness="2">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                        <TextBlock Text="{Binding LocDropHint}" FontSize="22" FontWeight="SemiBold"
                                   Foreground="{DynamicResource ThemeAccent}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding LocDropHintExt}" FontSize="14"
                                   Foreground="{DynamicResource ThemeTextSecondary}"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- Error overlay -->
                <Border IsVisible="{Binding HasError}"
                        HorizontalAlignment="Center" VerticalAlignment="Bottom"
                        Margin="16" CornerRadius="10" Padding="20,16"
                        MaxWidth="560"
                        Background="{DynamicResource ThemeErrorBg}" Opacity="0.95">
                    <StackPanel Spacing="10">
                        <TextBlock Text="{Binding LocErrorTitle}" FontWeight="Bold" FontSize="15"
                                   Foreground="{DynamicResource ThemeErrorText}" />
                        <ScrollViewer MaxHeight="140">
                            <SelectableTextBlock Text="{Binding ErrorDetail}" FontSize="11"
                                                  Foreground="{DynamicResource ThemeErrorText}" Opacity="0.8" TextWrapping="Wrap" />
                        </ScrollViewer>
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                            <Button Content="{Binding LocCopy}" Click="OnCopyErrorClick"
                                    Background="{DynamicResource ThemeBgButton}" Foreground="{DynamicResource ThemeTextSecondary}"
                                    Padding="12,4" CornerRadius="4" FontSize="11" />
                            <Button Content="{Binding LocDismiss}" Click="OnDismissErrorClick"
                                    Background="{DynamicResource ThemeAccentRed}" Foreground="White"
                                    Padding="14,4" CornerRadius="4" FontSize="11" FontWeight="SemiBold" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Panel>

            <!-- Right Splitter -->
            <GridSplitter Grid.Column="3" Width="4"
                          Background="Transparent"
                          ResizeBehavior="PreviousAndNext"
                          IsVisible="{Binding IsRightPanelVisible}" />

            <!-- Side Panel -->
            <Border Grid.Column="4"
                    Background="{DynamicResource ThemeBgSurface}"
                    BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1,0,0,0"
                    IsVisible="{Binding IsRightPanelVisible}">
                <Grid RowDefinitions="Auto,*">
                    <Border Grid.Row="0" Padding="8,6"
                            Background="{DynamicResource ThemeBgElevated}"
                            BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,0,0,1">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="Tools" FontWeight="SemiBold" FontSize="12"
                                       Foreground="{DynamicResource ThemeTextPrimary}"
                                       VerticalAlignment="Center" />
                            <Button Grid.Column="1" x:Name="RightPanelToggleBtn"
                                    Width="24" Height="24" Padding="0"
                                    CornerRadius="4" Background="Transparent"
                                    ToolTip.Tip="Collapse panel"
                                    Click="OnToggleRightPanelClick">
                                <svg:Svg x:Name="RightPanelToggleIcon"
                                         Path="avares://YSMViewer/Assets/svg/chevron-right.svg"
                                         Stretch="Uniform" Width="14" Height="14" />
                            </Button>
                        </Grid>
                    </Border>
                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="2" Margin="0,4">

                        <!-- Info Section -->
                        <Expander IsExpanded="True" Padding="0">
                            <Expander.Header>
                                <TextBlock Text="{Binding LocInfo}" FontWeight="SemiBold" FontSize="13"
                                           Foreground="{DynamicResource ThemeTextPrimary}" />
                            </Expander.Header>
                            <StackPanel Spacing="10" Margin="12,8">
                                <TextBlock Text="{Binding ModelDisplayName}"
                                           FontSize="18" FontWeight="Bold"
                                           Foreground="{DynamicResource ThemeTextPrimary}"
                                           TextWrapping="Wrap" />
                                <Border Height="1" Background="{DynamicResource ThemeDivider}" />
                                <StackPanel Spacing="6">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="Version" FontSize="11"
                                                   Foreground="{DynamicResource ThemeTextMuted}" Width="60" />
                                        <TextBlock Text="{Binding ModelVersion}"
                                                   FontSize="12" Foreground="{DynamicResource ThemeTextSecondary}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="8"
                                                IsVisible="{Binding HasModelAuthors}">
                                        <TextBlock Text="Authors" FontSize="11"
                                                   Foreground="{DynamicResource ThemeTextMuted}" Width="60" />
                                        <TextBlock Text="{Binding ModelAuthors}"
                                                   FontSize="12" Foreground="{DynamicResource ThemeTextSecondary}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="8"
                                                IsVisible="{Binding HasModelLicense}">
                                        <TextBlock Text="License" FontSize="11"
                                                   Foreground="{DynamicResource ThemeTextMuted}" Width="60" />
                                        <TextBlock Text="{Binding ModelLicense}"
                                                   FontSize="12" Foreground="{DynamicResource ThemeTextSecondary}" />
                                        <Border Background="{DynamicResource ThemeAccentGreen}" CornerRadius="3"
                                                Padding="5,1" VerticalAlignment="Center"
                                                IsVisible="{Binding IsFreeModel}">
                                            <TextBlock Text="FREE" FontSize="9" FontWeight="Bold"
                                                       Foreground="{DynamicResource ThemeBgViewport}" />
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock Text="{Binding ModelTips}"
                                           FontSize="11" Foreground="{DynamicResource ThemeTextLabel}"
                                           TextWrapping="Wrap"
                                           IsVisible="{Binding HasModelTips}" />
                            </StackPanel>
                        </Expander>

                        <!-- Components Section -->
                        <Expander IsExpanded="False" Padding="0">
                            <Expander.Header>
                                <TextBlock Text="{Binding LocComponents}" FontWeight="SemiBold" FontSize="13"
                                           Foreground="{DynamicResource ThemeTextPrimary}" />
                            </Expander.Header>
                            <StackPanel Spacing="6" Margin="12,8">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Button Content="{Binding LocShowAll}" FontSize="10"
                                            Click="OnShowAllComponentsClick"
                                            Padding="8,3" CornerRadius="4" />
                                    <Button Content="{Binding LocHideAll}" FontSize="10"
                                            Click="OnHideAllComponentsClick"
                                            Padding="8,3" CornerRadius="4" />
                                </StackPanel>
                                <ItemsControl ItemsSource="{Binding Components}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ComponentViewModel">
                                            <Border CornerRadius="4" Margin="0,2"
                                                    Padding="8,4"
                                                    Background="{DynamicResource ThemeBgElevated}">
                                                <Grid ColumnDefinitions="Auto,*">
                                                    <CheckBox Grid.Column="0"
                                                              IsChecked="{Binding IsVisible}"
                                                              FontSize="12" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding Name}"
                                                               Foreground="{DynamicResource ThemeTextPrimary}"
                                                               FontSize="12" VerticalAlignment="Center"
                                                               Margin="6,0,0,0"
                                                               TextTrimming="CharacterEllipsis" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Expander>

                        <!-- Bones Section -->
                        <Expander IsExpanded="False" Padding="0">
                            <Expander.Header>
                                <TextBlock Text="{Binding LocBones}" FontWeight="SemiBold" FontSize="13"
                                           Foreground="{DynamicResource ThemeTextPrimary}" />
                            </Expander.Header>
                            <StackPanel Spacing="6" Margin="12,8">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Button Content="{Binding LocExpandAll}" FontSize="10"
                                            Click="OnExpandAllBonesClick"
                                            Padding="8,3" CornerRadius="4" />
                                    <Button Content="{Binding LocCollapseAll}" FontSize="10"
                                            Click="OnCollapseAllBonesClick"
                                            Padding="8,3" CornerRadius="4" />
                                </StackPanel>
                                <ItemsControl ItemsSource="{Binding BoneGroups}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ComponentBoneGroupViewModel">
                                            <StackPanel IsVisible="{Binding IsVisible}" Spacing="4" Margin="0,0,0,8">
                                                <TextBlock Text="{Binding Name}" FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource ThemeTextSecondary}" />
                                                <TreeView ItemsSource="{Binding BoneRoots}"
                                                          Background="Transparent" BorderThickness="0"
                                                          Foreground="{DynamicResource ThemeTextPrimary}" FontSize="12">
                                                    <TreeView.Styles>
                                                        <Style Selector="TreeViewItem">
                                                            <Setter Property="Padding" Value="0" />
                                                            <Setter Property="Margin" Value="0" />
                                                        </Style>
                                                    </TreeView.Styles>
                                                    <TreeView.ItemTemplate>
                                                        <TreeDataTemplate ItemsSource="{Binding Children}"
                                                                          x:DataType="vm:BoneTreeItemViewModel">
                                                            <Grid ColumnDefinitions="Auto,*,Auto">
                                                                <TextBlock Grid.Column="0" Text="{Binding Icon}" FontSize="12"
                                                                           VerticalAlignment="Center" Margin="0,0,4,0" />
                                                                <TextBlock Grid.Column="1" Text="{Binding Name}"
                                                                           Foreground="{DynamicResource ThemeTextPrimary}"
                                                                           FontSize="12" VerticalAlignment="Center"
                                                                           TextTrimming="CharacterEllipsis" />
                                                                <ToggleButton Grid.Column="2" Width="24" Height="24"
                                                                              IsChecked="{Binding IsVisible, Mode=TwoWay}"
                                                                              CornerRadius="4" Padding="0" Margin="4,0,0,0"
                                                                              HorizontalContentAlignment="Center"
                                                                              VerticalContentAlignment="Center">
                                                                    <ToggleButton.Styles>
                                                                        <Style Selector="ToggleButton">
                                                                            <Setter Property="Background" Value="{DynamicResource ThemeToggleDefault}" />
                                                                        </Style>
                                                                        <Style Selector="ToggleButton:checked">
                                                                            <Setter Property="Background" Value="{DynamicResource ThemeToggleChecked}" />
                                                                        </Style>
                                                                        <Style Selector="ToggleButton:unchecked">
                                                                            <Setter Property="Background" Value="{DynamicResource ThemeToggleUnchecked}" />
                                                                        </Style>
                                                                    </ToggleButton.Styles>
                                                                    <TextBlock Text="◉" FontSize="11"
                                                                               HorizontalAlignment="Center"
                                                                               VerticalAlignment="Center" />
                                                                </ToggleButton>
                                                            </Grid>
                                                        </TreeDataTemplate>
                                                    </TreeView.ItemTemplate>
                                                </TreeView>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Expander>

                        <!-- Textures Section -->
                        <Expander IsExpanded="False" Padding="0"
                                  IsVisible="{Binding HasTextures}">
                            <Expander.Header>
                                <TextBlock Text="{Binding LocTextures}" FontWeight="SemiBold" FontSize="13"
                                           Foreground="{DynamicResource ThemeTextPrimary}" />
                            </Expander.Header>
                            <StackPanel Spacing="6" Margin="12,8">
                                <TextBlock Text="Image resources in this YSM file"
                                           FontSize="11" Foreground="{DynamicResource ThemeTextMuted}" />
                                <ItemsControl ItemsSource="{Binding TextureItems}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:TextureItemViewModel">
                                            <Border CornerRadius="6" Margin="0,0,0,6"
                                                    Padding="8" Background="{DynamicResource ThemeBgElevated}">
                                                <Grid ColumnDefinitions="56,*,Auto">
                                                    <Border Grid.Column="0" Width="56" Height="56"
                                                            CornerRadius="4"
                                                            Background="{DynamicResource ThemeBgViewport}"
                                                            ClipToBounds="True">
                                                        <Image Source="{Binding Thumbnail}"
                                                               Stretch="UniformToFill"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" />
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Margin="8,0,0,0"
                                                                VerticalAlignment="Center" Spacing="2">
                                                        <TextBlock Text="{Binding Name}"
                                                                   FontSize="12" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource ThemeTextPrimary}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                            <TextBlock Text="{Binding DimensionsDisplay}"
                                                                       FontSize="10" Foreground="{DynamicResource ThemeTextMuted}" />
                                                            <TextBlock Text="{Binding SizeDisplay}"
                                                                       FontSize="10" Foreground="{DynamicResource ThemeTextMuted}" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                    <Border Grid.Column="2" CornerRadius="3" Padding="5,2"
                                                            VerticalAlignment="Center"
                                                            Background="{Binding BadgeBrush}">
                                                        <TextBlock Text="{Binding Category}" FontSize="10"
                                                                   Foreground="White" FontWeight="SemiBold" />
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Expander>

                        <!-- Animations Section -->
                        <Expander IsExpanded="True" Padding="0"
                                  IsVisible="{Binding HasAnimations}">
                            <Expander.Header>
                                <TextBlock Text="{Binding LocAnimations}" FontWeight="SemiBold" FontSize="13"
                                           Foreground="{DynamicResource ThemeTextPrimary}" />
                            </Expander.Header>
                            <StackPanel Spacing="6" Margin="12,8">
                                <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding HasAnimationController}"
                                      Margin="0,0,0,4">
                                    <TextBlock Grid.Column="0" Text="Controller Mode"
                                               FontSize="12" VerticalAlignment="Center"
                                               Foreground="{DynamicResource ThemeTextSecondary}" />
                                    <ToggleSwitch Grid.Column="1"
                                                  IsChecked="{Binding UseAnimationController}"
                                                  OffContent="Manual" OnContent="Auto"
                                                  FontSize="11" />
                                </Grid>
                                <ListBox x:Name="AnimationListBox"
                                         ItemsSource="{Binding AnimationNames}"
                                         SelectedItem="{Binding CurrentAnimationName}"
                                         Background="Transparent" BorderThickness="0"
                                         Foreground="{DynamicResource ThemeTextPrimary}" FontSize="12"
                                         SelectionChanged="OnAnimationSelectionChanged"
                                         MaxHeight="200">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" Padding="6,4" />
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                    <ListBox.Styles>
                                        <Style Selector="ListBoxItem">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="CornerRadius" Value="4" />
                                        </Style>
                                        <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
                                            <Setter Property="Background" Value="{DynamicResource ThemeAnimSelected}" />
                                            <Setter Property="CornerRadius" Value="4" />
                                        </Style>
                                        <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                                            <Setter Property="Background" Value="{DynamicResource ThemeBgHover}" />
                                            <Setter Property="CornerRadius" Value="4" />
                                        </Style>
                                    </ListBox.Styles>
                                </ListBox>
                            </StackPanel>
                        </Expander>

                        <!-- Molang Variables Section -->
                        <Expander IsExpanded="False" Padding="0"
                                  IsVisible="{Binding HasMolangVariables}">
                            <Expander.Header>
                                <TextBlock Text="Molang Variables" FontWeight="SemiBold" FontSize="13"
                                           Foreground="{DynamicResource ThemeTextPrimary}" />
                            </Expander.Header>
                            <v:MolangPanelView DataContext="{Binding MolangPanel}" />
                        </Expander>

                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>

        <shared:ModelBottomBar Grid.Row="2" DataContext="{Binding}" />
</Grid>

    <!-- Toast overlay -->
    <ItemsControl ItemsSource="{Binding Notifications.Notifications}"
                  HorizontalAlignment="Right" VerticalAlignment="Top"
                  Margin="16,56,16,0" MaxWidth="380">
        <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:NotificationViewModel">
                <Border CornerRadius="8" Padding="12,8" Margin="0,0,0,8"
                        Background="{DynamicResource ThemeBgElevated}"
                        BorderBrush="{DynamicResource ThemeAccent}" BorderThickness="1">
                    <Grid ColumnDefinitions="Auto,*">
                        <TextBlock Grid.Column="0" Text="{Binding Type, Converter={StaticResource NotificationIconConverter}}"
                                   FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding Message}" TextWrapping="Wrap"
                                   Foreground="{DynamicResource ThemeTextPrimary}" FontSize="12"
                                   VerticalAlignment="Center" />
                    </Grid>
                </Border>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</Panel>
</UserControl>