<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>

  <!-- Normal COM library build -->
  <PropertyGroup Condition="'$(Configuration)' != 'DebugRuntest'">
    <OutputType>Library</OutputType>
    <EnableComHosting>true</EnableComHosting>
  </PropertyGroup>

  <!-- DebugRuntest: standalone console test harness -->
  <PropertyGroup Condition="'$(Configuration)' == 'DebugRuntest'">
    <OutputType>Exe</OutputType>
    <EnableComHosting>false</EnableComHosting>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\YSMViewer.Core\YSMViewer.Core.csproj" />
    <PackageReference Include="System.Drawing.Common" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Test\**" Condition="'$(Configuration)' != 'DebugRuntest'" />
    <Compile Remove="YsmThumbnailProvider.cs" Condition="'$(Configuration)' == 'DebugRuntest'" />
    <Compile Remove="ComInterfaces.cs" Condition="'$(Configuration)' == 'DebugRuntest'" />
  </ItemGroup>
</Project>
