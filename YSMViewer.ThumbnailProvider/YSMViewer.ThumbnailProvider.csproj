<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- Normal build: NativeAOT C ABI rendering library -->
  <PropertyGroup Condition="'$(Configuration)' != 'DebugRuntest'">
    <OutputType>Library</OutputType>
    <PublishAot>true</PublishAot>
    <IsTrimmable>true</IsTrimmable>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <IlcOptimizationPreference>Size</IlcOptimizationPreference>
    <IlcFoldIdenticalMethods>true</IlcFoldIdenticalMethods>
    <EnableComHosting>false</EnableComHosting>
  </PropertyGroup>

  <!-- DebugRuntest: standalone console test harness -->
  <PropertyGroup Condition="'$(Configuration)' == 'DebugRuntest'">
    <OutputType>Exe</OutputType>
    <DefineConstants>$(DefineConstants);TEST_HARNESS</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\YSMViewer.Core\YSMViewer.Core.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(Configuration)' != 'DebugRuntest'">
    <TrimmerRootDescriptor Include="ThumbnailTrimming.xml" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Drawing.Common" />
  </ItemGroup>
</Project>
