<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- Normal build: NativeAOT C ABI rendering library -->
  <PropertyGroup Condition="'$(Configuration)' != 'DebugRuntest'">
    <OutputType>Library</OutputType>
    <PublishAot>true</PublishAot>
    <IsTrimmable>true</IsTrimmable>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
  </PropertyGroup>

  <!-- DebugRuntest: standalone console test harness -->
  <PropertyGroup Condition="'$(Configuration)' == 'DebugRuntest'">
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\YSMViewer.Core\YSMViewer.Core.csproj" />
  </ItemGroup>

  <!-- AOT trimming -->
  <ItemGroup Condition="'$(Configuration)' != 'DebugRuntest'">
    <TrimmerRootAssembly Include="YSMViewer.ThumbnailProvider" />
    <TrimmerRootAssembly Include="YSMViewer.Core" />
  </ItemGroup>
</Project>
